generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@obraclick-prisma-v3/client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role                 String?   @default("cliente") // arquitecto, ingeniero, maestro, cliente
  password             String?
  plan                 String?   @default("FREE") // FREE, PRO, ENTERPRISE
  cif                  String?   @unique // CIF / NIF de empresa único para anti-abuso
  companyName          String?
  trialEndsAt          DateTime? // Fin de los 14 días de prueba
  stripeCustomerId     String?
  stripeSubscriptionId String?
  subscriptionStatus   String?   @default("ACTIVE")
  createdAt            DateTime  @default(now())
  
  accounts      Account[]
  sessions      Session[]
  projects      Project[]
  teamMembers   TeamMember[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Project {
  id           String        @id @default(cuid())
  name         String
  description  String?
  location     String?
  clientName   String?
  budget       Float         @default(0)
  spent        Float         @default(0)
  progress     Int           @default(0) // 0 - 100
  status       String        @default("EN_EJECUCION") // PLANIFICACION, EN_EJECUCION, PARALIZADA, FINALIZADA
  startDate    DateTime      @default(now())
  endDate      DateTime?
  clientToken  String?       @unique // Token para portal del cliente (read-only)
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  milestones   Milestone[]
  expenses     Expense[]
  dailyReports DailyReport[]
  incidents    Incident[]

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([userId])
}

model Milestone {
  id          String    @id @default(cuid())
  title       String
  description String?
  order       Int       @default(0)
  completed   Boolean   @default(false)
  completedAt DateTime?
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@index([projectId])
}

model DailyReport {
  id           String   @id @default(cuid())
  title        String
  notes        String
  weather      String?  // Soleado, Nublado, Lluvia
  workersCount Int      @default(0)
  imageUrl     String?
  signatureUrl String?
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@index([projectId])
}

model Incident {
  id          String   @id @default(cuid())
  title       String
  description String
  priority    String   @default("MEDIA") // BAJA, MEDIA, ALTA, URGENTE
  status      String   @default("ABIERTA") // ABIERTA, EN_REVISION, RESUELTA
  assignedTo  String?
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([projectId])
}

model Expense {
  id            String   @id @default(cuid())
  category      String   // MATERIALES, MANO_DE_OBRA, MAQUINARIA, SUBCONTRATAS, OTROS
  concept       String
  amount        Float
  date          DateTime @default(now())
  status        String   @default("PAGADO") // PAGADO, PENDIENTE, EN_REVISION
  supplier      String?
  invoiceNumber String?
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@index([projectId])
}

model TeamMember {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  role      String   // Arquitecto, Jefe de Obra, Maestro, Cuadrilla Albañilería, etc.
  company   String?  // Subcontrata o Empresa
  status    String   @default("ACTIVO") // ACTIVO, INACTIVO, EN_ESPERA
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
}
