# ObraClick - Entorno de configuración ejemplo

# Base de datos (SQLite para desarrollo local o PostgreSQL para producción)
DATABASE_URL="file:./dev.db"

# NextAuth - Autenticación y sesión
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="tu-secreto-aleatorio-aqui"

# URL pública de la app (sitemap, SEO y enlaces de emails). En local puede omitirse.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Tu email de propietario: único que puede activarse el Plan PRO sin pasarela de pago
ADMIN_EMAIL=""

# Solo para demos: "true" permite a CUALQUIER usuario pasar a PRO gratis. No lo uses en producción.
# ALLOW_FREE_PRO_UPGRADE="true"

# Google OAuth (Opcional - para inicio de sesión con Google)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Resend / Email Transaccional (Opcional)
RESEND_API_KEY=""
# Remitente de los emails (el dominio debe estar verificado en Resend)
# EMAIL_FROM="ObraClick <notificaciones@tu-dominio.com>"
